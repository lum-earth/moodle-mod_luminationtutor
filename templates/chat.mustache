{{!
    @template mod_luminationtutor/chat

    The tutor chat: earlier messages, a box to ask a question and the messages left today.

    Context variables required for this template:
    * cmid - Course module id.
    * messages - Earlier messages, see mod_luminationtutor/message.
    * hasmessages - Whether there are earlier messages.
    * maxlength - Longest message accepted.
    * remainingtext - Messages left today, as text.
    * cansend - Whether the user can send another message today.

    Example context (json):
    {
        "cmid": 4,
        "messages": [
            {"id": 1, "message": "What is photosynthesis?", "replyhtml": "<p>It is how plants make food from light.</p>"}
        ],
        "hasmessages": true,
        "maxlength": 2000,
        "remainingtext": "19 questions left today",
        "cansend": true
    }
}}
<div class="mod_luminationtutor-chat" data-region="mod_luminationtutor-chat" data-cmid="{{cmid}}">
    <p class="mod_luminationtutor-intro small text-muted{{#hasmessages}} d-none{{/hasmessages}}" data-region="intro">
        {{#str}}intro, mod_luminationtutor{{/str}}
    </p>
    <div class="mod_luminationtutor-history" data-region="history" aria-live="polite">
        {{#messages}}
            {{> mod_luminationtutor/message }}
        {{/messages}}
    </div>
    <form class="mod_luminationtutor-form mt-2" data-region="form">
        <label for="mod_luminationtutor-input-{{cmid}}" class="visually-hidden">{{#str}}yourquestion, mod_luminationtutor{{/str}}</label>
        <textarea id="mod_luminationtutor-input-{{cmid}}" class="form-control" rows="2" maxlength="{{maxlength}}"
            data-region="input" placeholder="{{#str}}askplaceholder, mod_luminationtutor{{/str}}"
            {{^cansend}}disabled{{/cansend}}></textarea>
        <div class="d-flex justify-content-between align-items-center mt-1">
            <span class="small text-muted" data-region="remaining">{{remainingtext}}</span>
            <button type="submit" class="btn btn-primary btn-sm" data-region="send" {{^cansend}}disabled{{/cansend}}>
                {{#str}}send, mod_luminationtutor{{/str}}
            </button>
        </div>
    </form>
</div>
